# ==============================================================================
# TRENDMARKET - CONFIGURATION ENVIRONMENT TEMPLATE (.env.example)
#
# IMPORTANT:
# 1. Do NOT put real secrets in this file. This file IS committed to Git.
# 2. To configure your local development environment:
#      cp .env.example .env
# 3. Add your real keys inside .env (which is strictly ignored by .gitignore).
# ==============================================================================

# Gemini AI API Key (Server-side execution only - NEVER exposed to frontend)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Application URL
APP_URL="http://localhost:3000"

# Cloud SQL / PostgreSQL Database Connection (Server-side execution only)
SQL_HOST="127.0.0.1"
SQL_DB_NAME="cloud_sql_development_database"
SQL_USER="postgres"
SQL_PASSWORD="YOUR_DATABASE_PASSWORD_HERE"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="YOUR_DATABASE_ADMIN_PASSWORD_HERE"

# Firebase Client Configuration (Optional environment variable overrides)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"
VITE_FIREBASE_OAUTH_CLIENT_ID="000000000000-xxxxxxxx.apps.googleusercontent.com"
